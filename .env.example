# Legal / imprint (required for production — set in Vercel)
LEGAL_OPERATOR_NAME=
LEGAL_LEGAL_FORM=
LEGAL_STREET_ADDRESS=
LEGAL_POSTAL_CODE=
LEGAL_CITY=
LEGAL_COUNTRY=Germany
LEGAL_CONTACT_EMAIL=
LEGAL_CONTACT_PHONE=
LEGAL_VAT_ID=
LEGAL_CONTENT_OFFICER=
LEGAL_JURISDICTION_CITY=
LEGAL_LAST_UPDATED=2026-07-26

# App URL (used for Lemon Squeezy redirects & magic links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# OpenAI
OPENAI_API_KEY=

# Beta gate (optional): when set, all pages require password at /beta-login
BETA_PASSWORD=

# --- Billing (Lemon Squeezy + Supabase) ---
# Set BILLING_ENABLED=true only after Supabase schema + Lemon Squeezy products are configured.
BILLING_ENABLED=false

# Supabase (Auth magic links + Postgres)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Lemon Squeezy (https://app.lemonsqueezy.com/settings/api)
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
# Set true for test-mode checkouts (Dashboard test mode)
LEMONSQUEEZY_TEST_MODE=false

# Variant IDs (Products → variant → ID in URL or API)
LEMONSQUEEZY_VARIANT_CREDITS_PACK=
LEMONSQUEEZY_VARIANT_MONTHLY=
LEMONSQUEEZY_VARIANT_YEARLY=
LEMONSQUEEZY_CREDITS_PACK_SIZE=5

# Optional analytics (opt-in cookie banner only loads tracking when true)
NEXT_PUBLIC_ENABLE_ANALYTICS=false

# Auth emails via Supabase Send Email Hook (see docs/AUTH_EMAIL_HOOK.md)
RESEND_API_KEY=
RESEND_FROM=Immo Brochure AI <onboarding@resend.dev>
SEND_EMAIL_HOOK_SECRET=

# Optional: only if you customize cache location (default on OneDrive uses a temp junction)
# NEXT_DIST_DIR=
